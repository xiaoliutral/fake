{
  "UseLocalConfigs": false,
  "Consul": {
    "Address": "https://consul.nanafa.com",
    // 用户机密
    "Token": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ObjectStorage": {
    "Provider": "TencentCos",
    "KeyPrefix": "dev",
    "Local": {
      "BasePath": "wwwroot/uploads",
      "BaseUrl": "/uploads"
    }
    // "AliyunOss": {
    //   "Endpoint": "oss-cn-hangzhou.aliyuncs.com",
    //   "AccessKeyId": "",
    //   "AccessKeySecret": "",
    //   "BucketName": "",
    //   "BaseUrl": "",
    //   "UseHttps": true
    // },
    // "TencentCos": {
    //   "Region": "ap-guangzhou",
    //   "SecretId": "",
    //   "SecretKey": "",
    //   "Bucket": "examplebucket-1250000000",
    //   "BaseUrl": "",
    //   "UseHttps": true
    // }
  },
  "FileManagement": {
    "DefaultMaxSizeBytes": 20971520,
    "DefaultSignedUrlExpiresSeconds": 3600,
    "Categories": {
      "waybill": {
        "MaxSizeBytes": 10485760,
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf" ],
        "UseSignedUrl": true
      },
      "document": {
        "MaxSizeBytes": 52428800,
        "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".zip" ],
        "UseSignedUrl": true
      },
      "avatar": {
        "MaxSizeBytes": 10485760,
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ],
        "UseSignedUrl": false
      }
    }
  }
}
